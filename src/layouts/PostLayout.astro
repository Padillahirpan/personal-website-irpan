---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import { formatDate, isoDate, readingTime } from '../utils/content';
import { SITE } from '../data/site';

interface Props {
  post: CollectionEntry<'writing'>;
  headings: { depth: number; slug: string; text: string }[];
  image?: string;
  jsonLd?: object;
}

const { post, headings, image, jsonLd } = Astro.props;
const { title, description, date, category, cover } = post.data;
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={`${title} — ${SITE.name}`} description={description} type="article" image={image} jsonLd={jsonLd}>
  <article class="py-10 md:py-16">
    <header class="mx-auto max-w-[68ch]">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{category}</span>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)} menit baca</span>
      </div>
      <h1 class="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight md:text-4xl">
        {title}
      </h1>
      <p class="mt-4 text-lg text-muted">{description}</p>
    </header>

    {
      cover && (
        <div class="mx-auto mt-8 max-w-[68ch]">
          <Image
            src={cover}
            alt={`Ilustrasi artikel: ${title}`}
            widths={[640, 960, 1280]}
            sizes="(min-width: 768px) 68ch, 100vw"
            class="w-full rounded-xl border border-line object-cover"
            loading="eager"
          />
        </div>
      )
    }

    <div class="mt-10 flex gap-10">
      {
        toc.length > 2 && (
          <aside class="sticky top-8 hidden h-fit w-52 shrink-0 lg:block" aria-label="Daftar isi">
            <p class="text-xs font-medium uppercase tracking-wide text-muted">Daftar isi</p>
            <ul class="mt-3 space-y-2 text-sm">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="text-muted transition-colors hover:text-accent">
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }

      <div class="prose min-w-0 flex-1">
        <slot />
      </div>
    </div>

    <footer class="mx-auto mt-12 max-w-[68ch] border-t border-line pt-6">
      <button id="copy-link" type="button" class="btn btn-secondary">
        Salin tautan artikel
      </button>
      <slot name="after" />
    </footer>
  </article>
</BaseLayout>

<script is:inline>
  var btn = document.getElementById('copy-link');
  if (btn) {
    btn.addEventListener('click', function () {
      navigator.clipboard.writeText(window.location.href).then(function () {
        var old = btn.textContent;
        btn.textContent = 'Tautan disalin';
        window.setTimeout(function () {
          btn.textContent = old;
        }, 2000);
      });
    });
  }
</script>
