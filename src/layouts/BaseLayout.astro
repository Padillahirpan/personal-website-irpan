---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  lang?: Lang;
}

const { title, description, image, type, jsonLd, lang = 'id' } = Astro.props;
const T = t(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead {title} {description} {image} {type} {jsonLd} {lang} />
  </head>
  <body class="min-h-dvh bg-bg font-sans text-ink antialiased">
    <a href="#konten" class="skip-link">{T.skipToContent}</a>
    <Header {lang} />
    <main id="konten" class="mx-auto w-full max-w-[1040px] px-5 sm:px-6">
      <slot />
    </main>
    <Footer {lang} />
  </body>
</html>
