---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
}

const { title, description, image, type, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead {title} {description} {image} {type} {jsonLd} />
  </head>
  <body class="min-h-dvh bg-bg font-sans text-ink antialiased">
    <a href="#konten" class="skip-link">Lewati ke konten</a>
    <Header />
    <main id="konten" class="mx-auto w-full max-w-[1040px] px-5 sm:px-6">
      <slot />
    </main>
    <Footer />
  </body>
</html>
