---
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/kebun', label: 'Kebun' },
  { href: '/writing', label: 'Writing' },
  { href: '/contact', label: 'Contact' },
];

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="border-b border-line">
  <div class="mx-auto flex w-full max-w-[1040px] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-5 sm:px-6">
    <a href="/" class="font-serif text-lg font-medium tracking-tight hover:text-accent transition-colors">
      Irpan
    </a>
    <nav aria-label="Navigasi utama" class="flex items-center gap-x-5 gap-y-2 text-sm">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'transition-colors hover:text-accent',
              isActive(item.href) ? 'text-accent' : 'text-muted',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
