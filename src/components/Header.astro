---
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import { t, withLang, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const T = t(lang);

const nav = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/kebun', label: 'Kebun' },
  { href: '/writing', label: 'Writing' },
  { href: '/contact', label: 'Contact' },
];

// Normalisasi path (lepas prefix /en) untuk penanda nav aktif.
const normalized = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const isActive = (href: string) => normalized === href || normalized.startsWith(`${href}/`);
---

<header class="border-b border-line">
  <div class="mx-auto flex w-full max-w-[1040px] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-5 sm:px-6">
    <a href={withLang('/', lang)} class="font-serif text-lg font-medium tracking-tight hover:text-accent transition-colors">
      IP
    </a>
    <nav aria-label={T.navAria} class="flex items-center gap-x-5 gap-y-2 text-sm">
      {
        nav.map((item) => (
          <a
            href={withLang(item.href, lang)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'transition-colors hover:text-accent',
              isActive(item.href) ? 'text-accent' : 'text-muted',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <LangToggle {lang} />
      <ThemeToggle label={T.themeToggleLabel} />
    </nav>
  </div>
</header>
