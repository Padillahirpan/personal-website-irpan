---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../PostList.astro';
import { SITE, waLink } from '../../data/site';
import { publishedPosts, sortPosts } from '../../utils/content';
import { t, withLang, type Lang } from '../../i18n/ui';
import profilePhoto from '../../assets/images/profile.jpg';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const T = t(lang);
const posts = sortPosts(publishedPosts(await getCollection('writing'))).slice(0, 3);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: 'Software Engineer',
  description: T.home.description,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  sameAs: [SITE.socials.github, SITE.socials.linkedin, SITE.socials.instagram],
};
---

<BaseLayout title={T.home.title} description={T.home.description} jsonLd={personJsonLd} lang={lang}>
  <section class="py-6 md:py-12">
    <div class="grid items-center gap-10 md:grid-cols-[1fr_auto]">
      <div>
        <h1 class="font-serif text-4xl font-medium leading-tight tracking-tight md:text-5xl">
          Hello👋
        </h1>
        <p class="mt-3 font-serif text-xl text-muted md:text-2xl">{T.home.tagline}</p>
        <p class="mt-6 max-w-[60ch] text-muted">{T.home.heroParagraph}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={withLang('/projects', lang)} class="btn btn-primary">{T.home.ctaPrimary}</a>
          <a href={`${withLang('/kebun', lang)}#pesan`} class="btn btn-secondary">{T.home.ctaSecondary}</a>
        </div>
      </div>
      <Image
        src={profilePhoto}
        alt={T.home.profileAlt}
        widths={[160, 320]}
        sizes="160px"
        class="size-40 rounded-full border border-line object-cover"
        loading="eager"
      />
    </div>
  </section>

  <section aria-labelledby="tiga-dunia" class="py-6 md:py-12">
    <h2 id="tiga-dunia" class="section-title">{T.home.doorsTitle}</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {
        T.home.cards.map((card) => (
          <a
            href={withLang(card.href, lang)}
            class="group flex flex-col rounded-xl border border-line bg-surface p-6 transition-colors hover:border-accent"
          >
            <h3 class="font-serif text-xl font-medium transition-colors group-hover:text-accent">
              {card.title}
            </h3>
            <p class="mt-2 text-sm text-muted">{card.text}</p>
            <span class="mt-4 text-sm text-accent">{T.home.enter}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="tulisan-terbaru" class="py-6 md:py-12">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="tulisan-terbaru" class="section-title">{T.home.latestTitle}</h2>
      <a href={withLang('/writing', lang)} class="text-sm text-muted transition-colors hover:text-accent">{T.home.latestAll}</a>
    </div>
    <div class="mt-6">
      <PostList posts={posts} lang={lang} />
    </div>
  </section>

  <section aria-labelledby="ajakan-kontak" class="py-6 md:py-12">
    <div class="rounded-xl border border-line bg-surface px-6 py-10 text-center md:px-12">
      <h2 id="ajakan-kontak" class="section-title">{T.home.contactTitle}</h2>
      <p class="mx-auto mt-3 max-w-[52ch] text-muted">{T.home.contactText}</p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href={withLang('/contact', lang)} class="btn btn-primary">{T.home.contactButton}</a>
        <a href={waLink} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
          {T.home.waButton}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
