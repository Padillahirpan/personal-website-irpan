---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, waLink } from '../../data/site';
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const T = t(lang);

const channels = [
  { label: 'Email', value: SITE.email, href: `mailto:${SITE.email}`, note: T.contact.emailNote },
  {
    label: 'LinkedIn',
    value: SITE.socials.linkedin.replace('https://www.', ''),
    href: SITE.socials.linkedin,
    note: T.contact.linkedinNote,
  },
  {
    label: 'GitHub',
    value: SITE.socials.github.replace('https://', ''),
    href: SITE.socials.github,
    note: T.contact.githubNote,
  },
  {
    label: 'WhatsApp',
    value: T.contact.whatsappValue,
    href: waLink,
    note: T.contact.whatsappNote,
  },
];
---

<BaseLayout title={`${T.contact.title} — ${SITE.name}`} description={T.contact.metaDescription} lang={lang}>
  <section class="py-6 md:py-12">
    <h1 class="font-serif text-4xl font-medium tracking-tight md:text-5xl">{T.contact.title}</h1>
    <p class="mt-4 max-w-[60ch] text-muted">{T.contact.intro}</p>

    <ul class="mt-10 divide-y divide-line">
      {
        channels.map((channel) => (
          <li>
            <a
              href={channel.href}
              class="group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-5"
              {...(channel.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <div>
                <p class="font-serif text-lg font-medium transition-colors group-hover:text-accent">
                  {channel.label}
                </p>
                <p class="text-sm text-muted">{channel.note}</p>
              </div>
              <span class="text-sm text-accent">{channel.value} →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
