---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
import { t, withLang, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
}

const { lang = 'id', project, prev, next } = Astro.props;
const T = t(lang);
const { Content } = await render(project);
const { title, summary, status, stack, cover, link } = project.data;
---

<BaseLayout title={`${title} — ${SITE.name}`} description={summary} lang={lang}>
  <article class="py-6 md:py-12">
    <a href={withLang('/projects', lang)} class="text-sm text-muted transition-colors hover:text-accent">{T.projects.back}</a>

    <header class="mt-6 max-w-[68ch]">
      <div class="flex flex-wrap items-center gap-2">
        <span class="chip">{T.status[status] ?? status}</span>
        {link && <a href={link} class="chip transition-colors hover:border-accent hover:text-accent" target="_blank" rel="noopener noreferrer">{T.projects.visit}</a>}
      </div>
      <h1 class="mt-4 font-serif text-4xl font-medium tracking-tight md:text-5xl">{title}</h1>
      <p class="mt-4 text-lg text-muted">{summary}</p>
      <ul class="mt-5 flex flex-wrap gap-2" aria-label={T.projects.stackLabel}>
        {stack.map((item) => <li class="chip">{item}</li>)}
      </ul>
    </header>

    {
      cover && (
        <div class="mx-auto mt-8 max-w-[68ch]">
          <Image
            src={cover}
            alt={T.projects.screenshotAlt(title)}
            widths={[640, 960, 1280]}
            sizes="(min-width: 768px) 68ch, 100vw"
            class="w-full rounded-xl border border-line"
            loading="eager"
          />
        </div>
      )
    }

    <div class="prose prose-sans mx-auto mt-10 max-w-[68ch]">
      <Content />
    </div>

    <nav class="mx-auto mt-14 max-w-[68ch] flex flex-col gap-4 border-t border-line pt-6 sm:flex-row sm:justify-between" aria-label={T.projects.navAria}>
      {
        prev ? (
          <a href={withLang(`/projects/${prev.id}`, lang)} class="text-sm text-muted transition-colors hover:text-accent">
            ← {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={withLang(`/projects/${next.id}`, lang)} class="text-sm text-muted transition-colors hover:text-accent sm:text-right">
            {next.data.title} →
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
