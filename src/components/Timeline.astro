---
import type { ExperienceEntry } from '../data/experience';
import type { Lang } from '../i18n/ui';

interface Props {
  entries: ExperienceEntry[];
  lang?: Lang;
}

const { entries, lang = 'id' } = Astro.props;
const endLabel = (end: string) => (lang === 'en' && end === 'Kini' ? 'Present' : end);
---

<ol class="relative space-y-12 border-l border-line pl-8">
  {
    entries.map((entry) => (
      <li class="relative">
        <span class="absolute -left-[35px] top-1.5 size-2.5 rounded-full bg-accent" aria-hidden="true" />
        <p class="text-sm text-muted">
          {entry.start} — {endLabel(entry.end)}
        </p>
        <h3 class="mt-1 font-serif text-lg font-medium">
          {entry.role[lang]} · <span class="text-accent">{entry.company}</span>
        </h3>
        {entry.summary && <p class="mt-1 text-sm text-muted">{entry.summary[lang]}</p>}
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm">
          {entry.impact.map((point) => (
            <li>{point[lang]}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>
