---
import { SITE } from '../data/site';
import { t, withLang, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const T = t(lang);
const year = new Date().getFullYear();

const socials = [
  { href: `mailto:${SITE.email}`, label: 'Email' },
  { href: SITE.socials.github, label: 'GitHub' },
  { href: SITE.socials.linkedin, label: 'LinkedIn' },
];
---

<footer class="mt-2">
  <div class="mx-auto w-full max-w-[1040px] px-5 py-2 sm:px-6">

    <p class="mt-2 border-t border-line pt-6 text-xs text-muted">
      © {year} Irpan · {T.footer.builtWith}
      <a href="https://astro.build" class="underline underline-offset-2 hover:text-accent" target="_blank" rel="noopener noreferrer">Astro</a>
    </p>
  </div>
</footer>
