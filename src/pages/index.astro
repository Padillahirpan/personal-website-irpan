---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE, waLink } from '../data/site';
import { publishedPosts, sortPosts } from '../utils/content';
import profilePhoto from '../assets/images/profile.jpg';

const posts = sortPosts(publishedPosts(await getCollection('writing'))).slice(0, 3);

const cards = [
  {
    href: '/projects',
    title: 'Engineering',
    text: 'Delapan tahun membangun aplikasi mobile dan web — dari kelas bahasa online sampai sistem inventori toko furnitur.',
  },
  {
    href: '/kebun',
    title: 'Kebun',
    text: 'Selada hidroponik yang ditanam serius, dipanen rutin, dan bisa dipesan langsung oleh restoran dan toko sayur.',
  },
  {
    href: '/writing',
    title: 'Tulisan',
    text: 'Jurnal, catatan teknis, dan pelajaran dari kebun. Ditulis pelan-pelan dan rutin.',
  },
];

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: 'Software Engineer',
  description: SITE.description,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  sameAs: [SITE.socials.github, SITE.socials.linkedin, SITE.socials.instagram],
};
---

<BaseLayout title={SITE.title} description={SITE.description} jsonLd={personJsonLd}>
  <section class="py-14 md:py-20">
    <div class="grid items-center gap-10 md:grid-cols-[1fr_auto]">
      <div>
        <h1 class="font-serif text-4xl font-medium leading-tight tracking-tight md:text-5xl">
          Irpan
        </h1>
        <p class="mt-3 font-serif text-xl text-muted md:text-2xl">{SITE.tagline}</p>
        <p class="mt-6 max-w-[60ch] text-muted">
          Delapan tahun membangun aplikasi Android dan web. Sejak 2026 saya juga menanam selada
          hidroponik — dan membangun sistem untuk mengelolanya. Di sini kamu bisa menjelajahi
          keduanya.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/projects" class="btn btn-primary">Lihat proyek</a>
          <a href="/kebun#pesan" class="btn btn-secondary">Pesan selada</a>
        </div>
      </div>
      <Image
        src={profilePhoto}
        alt="Foto profil Irpan"
        widths={[160, 320]}
        sizes="160px"
        class="size-40 rounded-full border border-line object-cover"
        loading="eager"
      />
    </div>
  </section>

  <section aria-labelledby="tiga-dunia" class="py-14 md:py-20">
    <h2 id="tiga-dunia" class="section-title">Satu tempat, tiga pintu</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {
        cards.map((card) => (
          <a
            href={card.href}
            class="group flex flex-col rounded-xl border border-line bg-surface p-6 transition-colors hover:border-accent"
          >
            <h3 class="font-serif text-xl font-medium transition-colors group-hover:text-accent">
              {card.title}
            </h3>
            <p class="mt-2 text-sm text-muted">{card.text}</p>
            <span class="mt-4 text-sm text-accent">Masuk →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="tulisan-terbaru" class="py-14 md:py-20">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="tulisan-terbaru" class="section-title">Tulisan terbaru</h2>
      <a href="/writing" class="text-sm text-muted transition-colors hover:text-accent">Semua tulisan →</a>
    </div>
    <div class="mt-6">
      <PostList posts={posts} />
    </div>
  </section>

  <section aria-labelledby="ajakan-kontak" class="py-14 md:py-20">
    <div class="rounded-xl border border-line bg-surface px-6 py-10 text-center md:px-12">
      <h2 id="ajakan-kontak" class="section-title">Mari terhubung</h2>
      <p class="mx-auto mt-3 max-w-[52ch] text-muted">
        Punya proyek, lowongan, atau sekadar ingin bicara soal selada? Saya senang ditemui di
        keduanya.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href="/contact" class="btn btn-primary">Hubungi saya</a>
        <a href={waLink} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
          WhatsApp (pesan selada)
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
