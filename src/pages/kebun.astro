---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, waLink } from '../data/site';
import {
  kebunCycle,
  kebunDeliveryArea,
  kebunFacts,
  kebunVarieties,
} from '../data/kebun';
import { formatDate } from '../utils/content';

import greenhouse from '../assets/images/kebun/greenhouse.jpg';
import nftChannel from '../assets/images/kebun/nft-channel.jpg';
import seladaCloseup from '../assets/images/kebun/selada-closeup.jpg';
import semaiTray from '../assets/images/kebun/semai-tray.jpg';
import panenCrate from '../assets/images/kebun/panen-crate.jpg';

const logs = (await getCollection('kebunLog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const gallery = [
  { src: greenhouse, alt: 'Bagian dalam greenhouse dengan talang NFT berbaris selada hijau' },
  { src: nftChannel, alt: 'Talang NFT dengan aliran nutrisi dan selada butterhead' },
  { src: seladaCloseup, alt: 'Kepala selada green oak yang tumbuh subur di net pot' },
  { src: semaiTray, alt: 'Bibit selada muda di tray semai rockwool' },
  { src: panenCrate, alt: 'Selada segar hasil panen tersusun dalam krat siap kirim' },
];
---

<BaseLayout
  title={`Kebun — ${SITE.name}`}
  description="Kebun selada hidroponik Irpan: sistem NFT, siklus tanam 30–35 hari, jurnal kebun, dan cara memesan selada untuk restoran dan toko sayur."
>
  <section class="py-14 md:py-20">
    <h1 class="font-serif text-4xl font-medium tracking-tight md:text-5xl">Kebun</h1>
    <div class="story mt-8 max-w-[68ch] space-y-5">
      <p>
        2026 saya mulai bertani selada hidroponik. Bukan karena sudah jago — justru karena belum.
        Saya ingin memahami makanan dari sisi produksinya, dan hidroponik terasa seperti cabang
        dari pekerjaan saya: sistem yang bisa diukur, diatur, dan diperbaiki.
      </p>
      <p>
        Ini kebun yang dikelola dengan cara belajar sambil berjalan. Beberapa siklus gagal karena
        saya telat memperhatikan suhu; beberapa berhasil karena rutinitas pagi tidak pernah
        ditinggal. Semua dicatat jujur di jurnal di bawah — termasuk yang tidak beres.
      </p>
      <p>
        Kalau Anda restoran atau toko sayur yang mencari selada segar dengan rantai pasok
        pendek, <a href="#pesan">cara memesannya ada di sini</a>.
      </p>
    </div>
  </section>

  <section aria-labelledby="sistem-kebun" class="py-14 md:py-20">
    <h2 id="sistem-kebun" class="section-title">Sistem kebun</h2>
    <dl class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {
        kebunFacts.map((fact) => (
          <div class="rounded-xl border border-line bg-surface p-4">
            <dt class="text-xs text-muted">{fact.label}</dt>
            <dd class="mt-1 font-serif text-2xl font-medium">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section aria-labelledby="siklus-tanam" class="py-14 md:py-20">
    <h2 id="siklus-tanam" class="section-title">Siklus tanam</h2>
    <ol class="mt-8 grid gap-4 md:grid-cols-5">
      {
        kebunCycle.map((step, i) => (
          <li class="relative rounded-xl border border-line bg-surface p-5">
            <span class="font-mono text-xs text-accent" aria-hidden="true">
              0{i + 1}
            </span>
            <h3 class="mt-1 font-serif text-lg font-medium">{step.title}</h3>
            <p class="mt-1 text-sm text-muted">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="jurnal-kebun" class="py-14 md:py-20">
    <h2 id="jurnal-kebun" class="section-title">Jurnal kebun</h2>
    <p class="mt-3 max-w-[60ch] text-sm text-muted">
      Catatan pendek langsung dari kebun. Entri terbaru di atas.
    </p>
    <ul class="mt-8 grid gap-6 md:grid-cols-3">
      {
        logs.map((log) => (
          <li class="overflow-hidden rounded-xl border border-line bg-surface">
            <Image
              src={log.data.photo}
              alt={`Foto jurnal kebun: ${log.data.title}`}
              widths={[400, 640]}
              sizes="(min-width: 768px) 33vw, 100vw"
              class="aspect-[4/3] w-full border-b border-line object-cover"
              loading="lazy"
            />
            <div class="p-5">
              <time datetime={log.data.date.toISOString()} class="text-sm text-muted">
                {formatDate(log.data.date)}
              </time>
              <h3 class="mt-1 font-serif text-lg font-medium">{log.data.title}</h3>
              <p class="prose prose-sans mt-2 text-sm text-muted">
                {log.body?.trim()}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="galeri" class="py-14 md:py-20">
    <h2 id="galeri" class="section-title">Galeri</h2>
    <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-3">
      {
        gallery.map((photo) => (
          <Image
            src={photo.src}
            alt={photo.alt}
            widths={[320, 640, 960]}
            sizes="(min-width: 768px) 33vw, 50vw"
            class="aspect-[4/3] w-full rounded-xl border border-line object-cover"
            loading="lazy"
          />
        ))
      }
    </div>
  </section>

  <section aria-labelledby="selada-ops" class="py-14 md:py-20">
    <div class="flex flex-col items-start gap-6 rounded-xl border border-line bg-surface p-6 md:flex-row md:items-center md:justify-between md:p-8">
      <div>
        <h2 id="selada-ops" class="section-title">Sistemnya saya bangun sendiri</h2>
        <p class="mt-2 max-w-[56ch] text-sm text-muted">
          Jadwal tanam, log panen, sampai rekap penjualan kebun dikelola lewat Selada Ops —
          aplikasi monitoring yang saya kembangkan dari nol.
        </p>
      </div>
      <a href="/projects/selada-ops" class="btn btn-secondary shrink-0">Lihat detail proyek</a>
    </div>
  </section>

  <section id="pesan" aria-labelledby="pesan-selada" class="scroll-mt-20 py-14 md:py-20">
    <div class="rounded-xl border border-line bg-surface p-6 md:p-10">
      <h2 id="pesan-selada" class="section-title">Pesan selada</h2>
      <p class="mt-3 max-w-[60ch] text-muted">
        Untuk restoran, toko sayur, dan dapur di area {kebunDeliveryArea}. Panen rutin, dipanen
        hari yang sama dengan pengiriman.
      </p>

      <dl class="mt-8 grid gap-6 sm:grid-cols-3">
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-muted">Varian</dt>
          <dd class="mt-2 space-y-1 text-sm">
            {kebunVarieties.map((variety) => <p>{variety}</p>)}
          </dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-muted">Kapasitas</dt>
          <dd class="mt-2 text-sm">
            Panen rutin tiap siklus (&#177;1.800 lubang tanam) &#123;&#123;isi kapasitas per minggu&#125;&#125;
          </dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-muted">Area kirim</dt>
          <dd class="mt-2 text-sm">{kebunDeliveryArea} &#123;&#123;isi detail&#125;&#125;</dd>
        </div>
      </dl>

      <div class="mt-8">
        <a href={waLink} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
          Pesan via WhatsApp
        </a>
        <p class="mt-3 text-xs text-muted">
          Tombol ini membuka WhatsApp dengan pesan yang sudah terisi otomatis.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
