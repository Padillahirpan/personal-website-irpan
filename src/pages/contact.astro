---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, waLink } from '../data/site';

const channels = [
  {
    label: 'Email',
    value: SITE.email,
    href: `mailto:${SITE.email}`,
    note: 'Proyek, kolaborasi, atau sekadar menyapa.',
  },
  {
    label: 'LinkedIn',
    value: SITE.socials.linkedin.replace('https://www.', ''),
    href: SITE.socials.linkedin,
    note: 'Profil profesional dan riwayat kerja.',
  },
  {
    label: 'GitHub',
    value: SITE.socials.github.replace('https://', ''),
    href: SITE.socials.github,
    note: 'Kode dan proyek terbuka.',
  },
  {
    label: 'Instagram',
    value: SITE.socials.instagram.replace('https://www.', ''),
    href: SITE.socials.instagram,
    note: 'Keseharian kebun, kadang kode.',
  },
  {
    label: 'WhatsApp',
    value: 'Pemesanan selada',
    href: waLink,
    note: 'Khusus untuk restoran dan toko yang ingin memesan selada.',
  },
];
---

<BaseLayout title={`Contact — ${SITE.name}`} description="Hubungi Irpan: email, LinkedIn, GitHub, Instagram, dan WhatsApp khusus pemesanan selada hidroponik.">
  <section class="py-14 md:py-20">
    <h1 class="font-serif text-4xl font-medium tracking-tight md:text-5xl">Contact</h1>
    <p class="mt-4 max-w-[60ch] text-muted">
      Cara paling cepat menghubungi saya lewat email. Untuk pemesanan selada, WhatsApp lebih
      cepat dibalas.
    </p>

    <ul class="mt-10 divide-y divide-line">
      {
        channels.map((channel) => (
          <li>
            <a
              href={channel.href}
              class="group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-5"
              {...(channel.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <div>
                <p class="font-serif text-lg font-medium transition-colors group-hover:text-accent">
                  {channel.label}
                </p>
                <p class="text-sm text-muted">{channel.note}</p>
              </div>
              <span class="text-sm text-accent">{channel.value} →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
